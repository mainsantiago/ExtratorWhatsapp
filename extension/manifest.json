{
  "manifest_version": 3,
  "name": "Extrator de Conversas para WhatsApp Web",
  "short_name": "Extrator WA",
  "version": "1.1.0",
  "description": "Exporta todas as conversas do WhatsApp Web com 1 clique: número, nome, data, hora e texto de cada mensagem, em CSV e JSON.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Extrair conversas do WhatsApp Web",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "host_permissions": ["https://web.whatsapp.com/*"],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "run_at": "document_idle",
      "js": [
        "src/lib/namespace.js",
        "src/lib/format.js",
        "src/lib/csv.js",
        "src/lib/zip.js",
        "src/adapters/idb.js",
        "src/adapters/dom.js",
        "src/core/normalize.js",
        "src/core/export.js",
        "src/core/extractor.js",
        "src/ui/overlay.js",
        "src/content.js"
      ]
    }
  ]
}
